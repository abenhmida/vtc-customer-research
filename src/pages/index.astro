---
import Questionnaire from "../components/Questionnaire.astro";
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Questionnaire anonyme pour chauffeurs VTC"/><title>VTC Customer Research</title></head><body><Questionnaire/></body></html>
<style is:global>
:root{font-family:Inter,system-ui,sans-serif;color:#17202a;background:#f5f7fa}*{box-sizing:border-box}body{margin:0}.shell{max-width:760px;margin:auto;padding:22px 16px 50px}header{padding:25px 0}header small,.q>small{font-weight:800;letter-spacing:.1em;opacity:.55}h1{font-size:clamp(30px,7vw,48px);line-height:1.05;margin:12px 0}header p{opacity:.6}.progress{position:sticky;top:0;background:#f5f7faeF;padding:12px 0 18px;z-index:5}.progress>span{font-size:13px;opacity:.6}.progress>span+span{float:right}.progress div{height:6px;background:#dfe5ec;border-radius:9px;margin-top:8px;overflow:hidden}.progress i{display:block;height:100%;width:5%;background:#17202a}.q{display:none;background:white;border:1px solid #e3e8ed;border-radius:18px;padding:clamp(22px,5vw,38px);box-shadow:0 10px 30px #1423330a}.q.active{display:block}h2{font-size:clamp(24px,5vw,34px);line-height:1.15;margin:12px 0 25px}.options{display:grid;gap:10px}.options label{display:flex;align-items:center;gap:12px;padding:14px;border:1px solid #dfe4e9;border-radius:12px;cursor:pointer}.options label:has(input:checked){background:#f0f3f6;border-color:#17202a}.options input{width:19px;height:19px;accent-color:#17202a}textarea{width:100%;border:1px solid #dfe4e9;border-radius:12px;padding:14px;font:inherit;resize:vertical}nav{display:flex;gap:10px;margin-top:28px}button{border:0;border-radius:11px;padding:13px 18px;font-weight:750;cursor:pointer}nav button:last-child{margin-left:auto;background:#17202a;color:white}.back{background:#edf1f4}.q>nav:only-child{justify-content:flex-end}#done{display:none;text-align:center;background:white;border-radius:18px;padding:55px 20px}#done.active{display:block}#done b{display:grid;place-items:center;width:58px;height:58px;margin:auto;border-radius:50%;background:#17202a;color:white;font-size:28px}#done h2{margin-bottom:8px}#done p,footer{color:#6c7883}footer{text-align:center;font-size:12px;padding:25px}
@media(max-width:560px){.shell{padding:10px 10px 35px}.q{padding:21px 16px}.options label{min-height:52px}nav button{width:100%}}
</style><style is:global>
.status{min-height:24px;margin:14px 0;text-align:center;color:#596774;font-size:14px}.status.error{color:#a33b3b;font-weight:650}.honeypot{position:absolute;left:-10000px;width:1px;height:1px;opacity:0;pointer-events:none}button:disabled{opacity:.6;cursor:not-allowed}
</style>
